---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'RAD MTB Coaching | Trail-Based Mountain Bike Skills Coaching',
	description = 'Premium mountain bike coaching for riders who want more confidence, more control, and faster progression on real trails.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0b0f0d" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: dark;
		--bg: #0b0f0d;
		--bg-soft: #131915;
		--panel: rgba(16, 22, 18, 0.8);
		--panel-strong: rgba(20, 26, 22, 0.94);
		--line: rgba(213, 206, 182, 0.14);
		--line-strong: rgba(213, 206, 182, 0.28);
		--text: #f4f1e8;
		--muted: #c9c4b2;
		--forest: #5d7c54;
		--forest-bright: #7da36d;
		--earth: #b69e77;
		--orange: #db7c34;
		--shadow: 0 24px 80px rgba(0, 0, 0, 0.34);
		--radius-xl: 32px;
		--radius-lg: 24px;
		--radius-md: 18px;
		--max-width: 1240px;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		min-width: 320px;
		min-height: 100vh;
		font-family: 'Inter', sans-serif;
		color: var(--text);
		background:
			radial-gradient(circle at top left, rgba(93, 124, 84, 0.22), transparent 32%),
			radial-gradient(circle at top right, rgba(219, 124, 52, 0.12), transparent 26%),
			linear-gradient(180deg, #0a0d0b 0%, #101511 48%, #0c100d 100%);
	}

	body::before {
		content: '';
		position: fixed;
		inset: 0;
		background:
			linear-gradient(125deg, rgba(255, 255, 255, 0.02), transparent 24%),
			url('/topography.svg');
		background-size: auto, cover;
		opacity: 0.18;
		pointer-events: none;
		z-index: -2;
	}

	body::after {
		content: '';
		position: fixed;
		inset: 0;
		background:
			repeating-linear-gradient(
				90deg,
				rgba(255, 255, 255, 0) 0,
				rgba(255, 255, 255, 0) 119px,
				rgba(255, 255, 255, 0.018) 120px
			);
		mask-image: linear-gradient(180deg, transparent, black 20%, black 85%, transparent);
		opacity: 0.5;
		pointer-events: none;
		z-index: -1;
	}

	a {
		color: inherit;
	}

	img {
		display: block;
		max-width: 100%;
	}

	button,
	input,
	textarea,
	select {
		font: inherit;
	}
</style>
