---
import Layout from '../layouts/Layout.astro';

const navItems = [
	{ label: 'Home', href: '#top' },
	{ label: 'Coaching', href: '#coaching' },
	{ label: 'Clinics', href: '#clinics' },
	{ label: 'Videos', href: '#videos' },
	{ label: 'About', href: '#about' },
	{ label: 'Book', href: '/book' },
];

const trustItems = [
	'Private Coaching',
	'Group Clinics',
	'Beginner to Advanced Riders',
	'Trail-Based Skills Training',
];

const metrics = [
	{ value: 'Real Trails', label: 'Skills taught where they matter most' },
	{ value: 'Small Groups', label: 'Clear coaching with room for feedback' },
	{ value: 'Progression', label: 'Sessions built around rider goals' },
];

const programs = [
	{
		title: 'Private Coaching',
		description: 'One-on-one sessions built around the exact habits, terrain, and features you want to improve.',
		focus: ['Cornering', 'Braking', 'Body position', 'Line choice'],
	},
	{
		title: 'Group Clinics',
		description: 'Small-group coaching that keeps the energy high while still giving every rider useful, specific feedback.',
		focus: ['Foundational skills', 'Trail confidence', 'Flow', 'Sessioning'],
	},
	{
		title: 'Jump / Drop Sessions',
		description: 'Focused progressions for riders who want to approach features with more consistency and less hesitation.',
		focus: ['Jump timing', 'Drops', 'Bike control', 'Takeoff posture'],
	},
	{
		title: 'Trail Skills Sessions',
		description: 'Ride actual descents and technical trail segments while working on control, speed management, and decision-making.',
		focus: ['Technical descents', 'Speed control', 'Terrain management', 'Commitment'],
	},
];

const skills = [
	'Cornering Technique',
	'Jump Fundamentals',
	'Drop Technique',
	'Technical Descents',
	'Line Choice',
	'Climbing Efficiency',
	'Braking Control',
	'Body Position',
];

const videoCards = [
	{
		title: 'Technique Demonstrations',
		description: 'Short breakdowns that show what good movement actually looks like on trail.',
	},
	{
		title: 'Rider Progression Clips',
		description: 'Before-and-after style edits that make progress visible and motivating.',
	},
	{
		title: 'Coaching Moments',
		description: 'On-trail instruction, live cues, and the kind of feedback riders can use immediately.',
	},
];

const testimonials = [
	'I finally felt confident on jumps I used to avoid.',
	'I learned more in one session than months of riding alone.',
	'The coaching was clear, encouraging, and immediately useful.',
];

const locations = [
	{
		name: 'Bellingham',
		detail: 'A home base for riders who want access to steep, fast, technical terrain and varied skill progression.',
	},
	{
		name: 'Galbraith Mountain',
		detail: 'Perfect for cornering work, trail flow, line choice, and feature progression on real dirt.',
	},
	{
		name: 'Chuckanut',
		detail: 'A strong setting for commitment, technical descending, traction awareness, and terrain reading.',
	},
	{
		name: 'Tiger Mountain',
		detail: 'A bigger-mountain option for riders who want speed control and confidence on more demanding lines.',
	},
];

const pricing = [
	{ name: 'Private Coaching', price: '$150', note: 'Focused one-on-one trail session' },
	{ name: 'Group Clinic', price: '$95', note: 'Shared progression with a small crew' },
	{ name: 'Trail Session', price: '$120', note: 'Guided coaching on real descents' },
];

const bookingSteps = [
	'Choose the session format that matches your goals.',
	'Pick a location and terrain focus for the day.',
	'Ride with a plan, get live feedback, and leave with specific next steps.',
];
---

<Layout
	title="RAD MTB Coaching | Premium Trail-Based Mountain Bike Coaching"
	description="A cinematic mountain bike coaching landing page focused on confidence, progression, and real trail skills."
>
	<div class="page-shell">
		<header class="site-header">
			<a class="brand" href="#top" aria-label="RAD MTB Coaching home">
				<span class="brand-mark">RAD</span>
				<span class="brand-copy">
					<span>MTB Coaching</span>
					<span>Trail-first rider progression</span>
				</span>
			</a>

			<nav class="site-nav" aria-label="Primary">
				{navItems.map((item) => (
					<a href={item.href}>{item.label}</a>
				))}
			</nav>

			<a class="nav-cta" href="/book">Book Coaching</a>
		</header>

		<main id="top">
			<section class="hero section">
				<div class="hero-copy reveal" style="--delay: 0.08s;">
					<p class="eyebrow">Bellingham, WA | Cinematic trail coaching</p>
					<h1>Ride with confidence. Ride with control.</h1>
					<p class="lede">
						Mountain bike coaching designed to improve technique, confidence, and control on
						real trails, not just parking-lot drills.
					</p>

					<div class="hero-actions">
						<a class="button button-primary" href="/book">Book Coaching</a>
						<a class="button button-secondary" href="#coaching">See Programs</a>
					</div>

					<ul class="hero-metrics" aria-label="Key highlights">
						{metrics.map((item) => (
							<li>
								<strong>{item.value}</strong>
								<span>{item.label}</span>
							</li>
						))}
					</ul>
				</div>

				<div class="hero-visual reveal" style="--delay: 0.2s;">
					<div class="visual-frame visual-frame-main">
						<div class="frame-overlay">
							<span class="frame-kicker">Hero Film</span>
							<h2>Descents, coaching moments, and visuals that feel immersive.</h2>
							<p>Built to hold a full-screen rider image or video with bold typography on top.</p>
						</div>
						<div class="frame-stats">
							<span>Confidence</span>
							<span>Control</span>
							<span>Progression</span>
						</div>
					</div>

					<div class="visual-grid">
						<div class="visual-frame visual-frame-detail">
							<div class="frame-overlay">
								<span class="frame-kicker">Shot Direction 01</span>
								<p>Berms, braking zones, and mid-turn body position.</p>
							</div>
						</div>
						<div class="visual-frame visual-frame-accent">
							<div class="frame-overlay">
								<span class="frame-kicker">Shot Direction 02</span>
								<p>Jump sessions, rider progression clips, and coach-rider interaction.</p>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="trust-strip reveal" style="--delay: 0.28s;">
				{trustItems.map((item) => (
					<div class="trust-pill">{item}</div>
				))}
			</section>

			<section id="coaching" class="section content-grid">
				<div class="section-heading reveal" style="--delay: 0.05s;">
					<p class="eyebrow">Coaching Programs</p>
					<h2>Coaching formats built for real progression.</h2>
					<p>
						Each format keeps the visual feel of a premium MTB brand site while staying focused
						on coaching outcomes, rider confidence, and trail performance.
					</p>
				</div>

				<div class="program-grid">
					{programs.map((program, index) => (
						<article class="program-card reveal" style={`--delay: ${0.08 + index * 0.06}s;`}>
							<div class="card-topline"></div>
							<p class="card-index">0{index + 1}</p>
							<h3>{program.title}</h3>
							<p>{program.description}</p>
							<ul class="tag-list">
								{program.focus.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</article>
					))}
				</div>
			</section>

			<section id="clinics" class="section split-section">
				<div class="split-card reveal" style="--delay: 0.06s;">
					<p class="eyebrow">Clinic Experience</p>
					<h2>Small groups. Clear feedback. More reps.</h2>
					<p>
						Group sessions should still feel premium. The layout makes room for bold event
						posters, clinic calendars, and media that shows riders learning together rather than
						a generic service grid.
					</p>
				</div>

				<div class="editorial-stack reveal" style="--delay: 0.16s;">
					<div class="editorial-card">
						<span>Foundations</span>
						<p>Beginner-friendly clinics for braking, body position, and confidence on trail.</p>
					</div>
					<div class="editorial-card">
						<span>Flow Sessions</span>
						<p>Cornering and line-choice clinics designed around speed, rhythm, and vision.</p>
					</div>
					<div class="editorial-card">
						<span>Feature Focus</span>
						<p>Jump and drop progressions that stay structured, safe, and confidence-building.</p>
					</div>
				</div>
			</section>

			<section class="section content-grid">
				<div class="section-heading reveal" style="--delay: 0.05s;">
					<p class="eyebrow">Skills Riders Will Learn</p>
					<h2>Core skills for real trail riding.</h2>
				</div>

				<div class="skills-grid">
					{skills.map((skill, index) => (
						<div class="skill-card reveal" style={`--delay: ${0.06 + index * 0.04}s;`}>
							<span>{String(index + 1).padStart(2, '0')}</span>
							<h3>{skill}</h3>
						</div>
					))}
				</div>
			</section>

			<section id="videos" class="section media-section">
				<div class="media-lead reveal" style="--delay: 0.05s;">
					<p class="eyebrow">Video Training</p>
					<h2>Use video to show the coaching in motion.</h2>
					<p>
						This section is designed for YouTube embeds, progression edits, and technique
						breakdowns. The styling supports widescreen video without collapsing into a generic
						content block.
					</p>
				</div>

				<div class="media-layout">
					<div class="video-stage reveal" style="--delay: 0.12s;">
						<div class="video-screen">
							<div class="play-button" aria-hidden="true"></div>
							<div class="video-copy">
								<span>Featured Video</span>
								<h3>Technique demo or rider progression edit</h3>
								<p>Swap this panel for a YouTube embed when footage is ready.</p>
							</div>
						</div>
					</div>

					<div class="media-cards">
						{videoCards.map((item, index) => (
							<article class="media-card reveal" style={`--delay: ${0.16 + index * 0.06}s;`}>
								<span>{String(index + 1).padStart(2, '0')}</span>
								<h3>{item.title}</h3>
								<p>{item.description}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<section id="about" class="section split-section about-section">
				<div class="split-card reveal" style="--delay: 0.06s;">
					<p class="eyebrow">About The Coach</p>
					<h2>Trail knowledge, calm feedback, and repeatable progression.</h2>
					<p>
						The copy direction here emphasizes experience on real terrain, professional
						communication, and confidence building rather than hype. It gives the brand an
						outdoor-performance feel while keeping the subject squarely on rider development.
					</p>
				</div>

				<div class="philosophy-grid reveal" style="--delay: 0.16s;">
					<div class="philosophy-card">
						<h3>Real Trail Context</h3>
						<p>Skills are coached on the terrain riders actually struggle with, not abstract drills alone.</p>
					</div>
					<div class="philosophy-card">
						<h3>Clear Progressions</h3>
						<p>Sessions move from fundamentals to commitment in a way that feels measured and repeatable.</p>
					</div>
					<div class="philosophy-card">
						<h3>Confidence That Sticks</h3>
						<p>Riders leave with technique cues they can use on future rides, not just during the session.</p>
					</div>
				</div>
			</section>

			<section class="section content-grid">
				<div class="section-heading reveal" style="--delay: 0.05s;">
					<p class="eyebrow">Testimonials</p>
					<h2>Proof that riders feel the difference.</h2>
				</div>

				<div class="testimonial-grid">
					{testimonials.map((quote, index) => (
						<blockquote class="testimonial-card reveal" style={`--delay: ${0.08 + index * 0.06}s;`}>
							<p>{quote}</p>
						</blockquote>
					))}
				</div>
			</section>

			<section class="section locations-section">
				<div class="section-heading reveal" style="--delay: 0.05s;">
					<p class="eyebrow">Locations</p>
					<h2>Real trail environments across the Northwest.</h2>
					<p>
						Place matters. The location section is structured to feel like a rider's map, not a
						plain text list of trail names.
					</p>
				</div>

				<div class="location-grid">
					{locations.map((location, index) => (
						<article class="location-card reveal" style={`--delay: ${0.08 + index * 0.05}s;`}>
							<span class="location-dot"></span>
							<h3>{location.name}</h3>
							<p>{location.detail}</p>
						</article>
					))}
				</div>
			</section>

			<section id="book" class="section booking-section">
				<div class="booking-callout reveal" style="--delay: 0.05s;">
					<p class="eyebrow">Booking</p>
					<h2>Booking and availability live on a dedicated page.</h2>
					<p>
						Use the booking page for session details, preparation notes, and the Calendly
						availability placeholder that will become the live scheduling surface.
					</p>
					<a class="button button-primary" href="/book">Open Booking Page</a>
				</div>

				<div class="pricing-panel reveal" style="--delay: 0.14s;">
					<div class="pricing-grid">
						{pricing.map((item) => (
							<div class="price-card">
								<p>{item.name}</p>
								<h3>{item.price}</h3>
								<span>{item.note}</span>
							</div>
						))}
					</div>

					<div class="booking-steps">
						{bookingSteps.map((step, index) => (
							<div class="booking-step">
								<span>{String(index + 1).padStart(2, '0')}</span>
								<p>{step}</p>
							</div>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<p>RAD MTB Coaching</p>
			<span>Premium mountain bike coaching for rider progression, confidence, and control.</span>
		</footer>
	</div>
</Layout>

<style>
	.page-shell {
		width: min(calc(100% - 32px), var(--max-width));
		margin: 0 auto;
		padding: 22px 0 48px;
	}

	.site-header {
		position: sticky;
		top: 16px;
		z-index: 20;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 18px;
		padding: 14px 18px;
		margin-bottom: 28px;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: rgba(8, 11, 9, 0.72);
		backdrop-filter: blur(16px);
		box-shadow: var(--shadow);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 14px;
		text-decoration: none;
	}

	.brand-mark,
	.eyebrow,
	.site-nav a,
	.card-index,
	.frame-kicker,
	.media-card span,
	.location-dot,
	.booking-step span,
	.skill-card span {
		font-family: 'Anton', Impact, sans-serif;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.brand-mark {
		display: inline-grid;
		place-items: center;
		width: 52px;
		height: 52px;
		border-radius: 50%;
		color: #0d120e;
		background: linear-gradient(135deg, var(--forest-bright), var(--earth));
		font-size: 1.05rem;
	}

	.brand-copy {
		display: grid;
		gap: 2px;
	}

	.brand-copy span:first-child {
		font-weight: 700;
	}

	.brand-copy span:last-child {
		color: var(--muted);
		font-size: 0.82rem;
	}

	.site-nav {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 20px;
		flex: 1;
	}

	.site-nav a {
		color: var(--muted);
		font-size: 0.78rem;
		text-decoration: none;
	}

	.site-nav a:hover,
	.site-nav a:focus-visible {
		color: var(--text);
	}

	.nav-cta,
	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 48px;
		padding: 0 18px;
		border-radius: 999px;
		border: 1px solid transparent;
		font-weight: 700;
		text-decoration: none;
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			background 0.2s ease;
	}

	.nav-cta,
	.button-primary {
		color: #081008;
		background: linear-gradient(135deg, var(--forest-bright), #d3c498 86%);
	}

	.button-secondary {
		border-color: var(--line-strong);
		background: rgba(255, 255, 255, 0.04);
	}

	.nav-cta:hover,
	.nav-cta:focus-visible,
	.button:hover,
	.button:focus-visible {
		transform: translateY(-2px);
	}

	main {
		display: grid;
		gap: 34px;
	}

	.section {
		scroll-margin-top: 110px;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(340px, 0.95fr);
		gap: 28px;
		align-items: stretch;
		padding-top: 18px;
		min-height: calc(100vh - 148px);
	}

	.hero-copy,
	.hero-visual,
	.trust-strip,
	.program-card,
	.split-card,
	.editorial-card,
	.skill-card,
	.video-stage,
	.media-card,
	.philosophy-card,
	.testimonial-card,
	.location-card,
	.booking-callout,
	.pricing-panel {
		animation: rise 0.8s ease both;
		animation-delay: var(--delay, 0s);
	}

	.hero-copy {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 40px 10px 40px 0;
	}

	.eyebrow {
		margin: 0 0 14px;
		color: var(--earth);
		font-size: 0.82rem;
	}

	h1,
	h2,
	h3 {
		margin: 0;
		line-height: 1.02;
	}

	h1,
	h2 {
		font-family: 'Anton', Impact, sans-serif;
		text-transform: uppercase;
		letter-spacing: 0.015em;
	}

	h1 {
		max-width: 12ch;
		font-size: clamp(3.6rem, 7vw, 6.4rem);
	}

	h2 {
		font-size: clamp(2rem, 3.3vw, 3.4rem);
	}

	h3 {
		font-size: 1.45rem;
		line-height: 1.05;
	}

	.lede,
	.section-heading > p:last-child,
	.split-card p:last-child,
	.media-lead p:last-child,
	.booking-callout p:last-of-type,
	.location-card p,
	.philosophy-card p,
	.media-card p,
	.program-card p,
	.testimonial-card p,
	.editorial-card p,
	.video-copy p {
		color: var(--muted);
		line-height: 1.65;
	}

	.lede {
		max-width: 58ch;
		margin: 20px 0 0;
		font-size: 1.05rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 28px;
	}

	.hero-metrics {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 14px;
		padding: 0;
		margin: 36px 0 0;
		list-style: none;
	}

	.hero-metrics li {
		padding: 18px;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.02));
	}

	.hero-metrics strong {
		display: block;
		margin-bottom: 8px;
		font-size: 1.05rem;
	}

	.hero-metrics span {
		color: var(--muted);
		font-size: 0.92rem;
		line-height: 1.45;
	}

	.hero-visual {
		display: grid;
		grid-template-rows: minmax(360px, 1fr) auto;
		gap: 18px;
	}

	.visual-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 18px;
	}

	.visual-frame {
		position: relative;
		overflow: hidden;
		border: 1px solid rgba(213, 206, 182, 0.16);
		border-radius: var(--radius-xl);
		background:
			linear-gradient(180deg, rgba(7, 9, 7, 0.02), rgba(7, 9, 7, 0.84)),
			radial-gradient(circle at 20% 20%, rgba(125, 163, 109, 0.34), transparent 25%),
			radial-gradient(circle at 82% 22%, rgba(219, 124, 52, 0.26), transparent 24%),
			linear-gradient(135deg, #1d261e 0%, #0f1411 60%, #151611 100%);
		box-shadow: var(--shadow);
	}

	.visual-frame::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(120deg, rgba(255, 255, 255, 0.1), transparent 32%);
		opacity: 0.65;
	}

	.visual-frame-main {
		min-height: 520px;
	}

	.visual-frame-detail,
	.visual-frame-accent {
		min-height: 220px;
	}

	.visual-frame-detail {
		background:
			linear-gradient(180deg, rgba(7, 9, 7, 0.06), rgba(7, 9, 7, 0.86)),
			radial-gradient(circle at 20% 30%, rgba(182, 158, 119, 0.18), transparent 30%),
			linear-gradient(145deg, #1f221c 0%, #10130f 100%);
	}

	.visual-frame-accent {
		background:
			linear-gradient(180deg, rgba(7, 9, 7, 0.06), rgba(7, 9, 7, 0.86)),
			radial-gradient(circle at 70% 25%, rgba(219, 124, 52, 0.22), transparent 26%),
			linear-gradient(145deg, #23221b 0%, #10130f 100%);
	}

	.frame-overlay {
		position: absolute;
		inset: auto 0 0;
		padding: 28px;
		z-index: 1;
	}

	.frame-kicker {
		display: inline-block;
		margin-bottom: 12px;
		color: var(--earth);
		font-size: 0.76rem;
	}

	.frame-overlay h2 {
		max-width: 12ch;
		font-size: clamp(1.75rem, 2.5vw, 2.5rem);
	}

	.frame-overlay p {
		max-width: 38ch;
		margin: 14px 0 0;
		color: var(--muted);
		line-height: 1.6;
	}

	.frame-stats {
		position: absolute;
		top: 20px;
		right: 20px;
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		max-width: 240px;
		justify-content: flex-end;
	}

	.frame-stats span,
	.trust-pill,
	.tag-list li {
		padding: 10px 14px;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 999px;
		background: rgba(8, 11, 9, 0.52);
		backdrop-filter: blur(12px);
		font-size: 0.86rem;
	}

	.trust-strip {
		display: grid;
